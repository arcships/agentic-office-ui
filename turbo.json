{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "2",
  "globalDependencies": ["pnpm-lock.yaml", "tsconfig*.json", "patches/**"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["typecheck", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
