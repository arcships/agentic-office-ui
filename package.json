{
  "name": "agentic-office-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter=demo dev",
    "dev:pptx-lab": "pnpm --filter=pptx-playback-lab dev",
    "build": "turbo run build",
    "build:changed": "turbo run build --filter=...[origin/master]",
    "build:pptx": "pnpm --filter=@arcships/pptx-core build && pnpm --filter=@arcships/vue-pptx build && pnpm --filter=pptx-playback-lab build:lab && pnpm --filter=demo build",
    "typecheck": "turbo run typecheck",
    "typecheck:changed": "turbo run typecheck --filter=...[origin/master]",
    "typecheck:pptx": "pnpm --filter=@arcships/pptx-core typecheck && pnpm --filter=@arcships/vue-pptx typecheck && pnpm --filter=pptx-playback-lab typecheck && pnpm --filter=demo typecheck",
    "test": "node scripts/ci/run-suite.mjs test",
    "test:pptx": "pnpm build:pptx && node scripts/ci/verify-pptx-development.mjs && node --test --test-concurrency=1 tests/unit/pptx-core.test.mjs tests/unit/pptx-media-transitions.test.mjs tests/unit/pptx-morph-geometry.test.mjs tests/unit/pptx-track-player.test.mjs tests/unit/pptx-text-runs.test.mjs tests/unit/pptx-playback-v2.test.mjs tests/unit/pptx-transition-sound.test.mjs tests/unit/pptx-baseline-contract.test.mjs tests/unit/pptx-browser-session.test.mjs tests/unit/pptx-playback-controller.test.mjs tests/unit/pptx-hyperlinks.test.mjs tests/unit/pptx-speaker-notes.test.mjs tests/unit/pptx-transitions.test.mjs tests/component/pptx-preview.test.mjs tests/component/pptx-hyperlinks.test.mjs tests/component/pptx-presenter-view.test.mjs && node scripts/ci/verify-pptx-consumer.mjs",
    "test:pptx:headless": "python3 scripts/ci/verify-pptx-headless-browser.py",
    "test:pptx:baselines": "python3 scripts/fixtures/capture-pptx-formal-baselines.py --check",
    "test:pptx:blackbox": "node scripts/ci/verify-pptx-playback-browser.mjs",
    "test:xlsx:chrome": "node scripts/ci/run-python.mjs scripts/ci/verify-xlsx-chrome-interaction.py",
    "capture:pptx-baselines": "python3 scripts/fixtures/capture-pptx-formal-baselines.py",
    "test:visual": "RUN_PYTHON_MODULES=playwright,PIL node scripts/ci/run-python.mjs scripts/ci/capture-visual-matrix.py --check",
    "baseline:visual": "RUN_PYTHON_MODULES=playwright,PIL node scripts/ci/run-python.mjs scripts/ci/capture-visual-matrix.py --update-baseline",
    "report:visual": "python3 scripts/ci/capture-visual-matrix.py --report-only --output output/visual-matrix/report",
    "test:unit": "node scripts/ci/run-suite.mjs unit",
    "test:component": "node scripts/ci/run-suite.mjs component",
    "test:shard": "node scripts/ci/run-acceptance-shard.mjs",
    "test:acceptance": "node scripts/ci/run-acceptance-shard.mjs all",
    "test:blackbox": "node scripts/ci/run-suite.mjs blackbox",
    "test:pdf": "node scripts/ci/run-suite.mjs pdf",
    "test:pdf:chrome": "node scripts/ci/run-python.mjs scripts/ci/capture-pdf-chrome.py --serve apps/demo/dist",
    "test:stress": "node scripts/ci/run-suite.mjs stress",
    "test:performance": "node scripts/ci/run-suite.mjs performance",
    "test:matrix": "node scripts/ci/run-suite.mjs matrix",
    "test:e2e": "node scripts/ci/run-suite.mjs blackbox",
    "test:consumer": "node scripts/ci/run-suite.mjs consumer",
    "test:pack": "node scripts/ci/run-suite.mjs consumer",
    "test:docs": "node scripts/ci/run-suite.mjs docs",
    "test:release": "node scripts/ci/run-suite.mjs release",
    "ci:self-test": "node scripts/ci/verify-failure-propagation.mjs",
    "ui:parity": "node scripts/ci/pixel-parity.mjs",
    "ui:parity:report": "node scripts/ci/pixel-parity.mjs --report-only",
    "ui:parity:core": "node scripts/ci/pixel-parity.mjs --only core --gate-mode all --baseline --skip-tokens",
    "ui:parity:full": "node scripts/ci/pixel-parity.mjs --gate-mode all --baseline --skip-tokens",
    "ui:parity:self-check": "node scripts/ci/pixel-parity.mjs --self-check --out output/ui-parity-selfcheck",
    "ui:parity:routes": "node scripts/ci/route-parity.mjs",
    "visual:audit:atlas": "python3 scripts/ci/visual-audit-tiles.py",
    "ui:parity:routes:report": "node scripts/ci/route-parity.mjs -- --gate-mode off",
    "ui:baseline": "node scripts/ci/visual-baseline.mjs",
    "ui:baseline:verify": "node scripts/ci/visual-baseline.mjs verify --require-approval",
    "ui:baseline:status": "node scripts/ci/visual-baseline.mjs status",
    "lint:style": "node scripts/ci/lint-styles.mjs",
    "lint:style:baseline": "node scripts/ci/lint-styles.mjs --write-baseline",
    "test:a11y": "node scripts/ci/a11y-check.mjs",
    "ui:tokens": "node scripts/ci/extract-extend-tokens.mjs",
    "ui:tokens:check": "node scripts/ci/extract-extend-tokens.mjs --check",
    "ui:docs": "node scripts/ci/verify-ui-docs.mjs",
    "icons:check": "node scripts/ci/verify-icons.mjs",
    "check": "node scripts/ci/run-suite.mjs check"
  },
  "devDependencies": {
    "@arcships/office-runtime": "workspace:*",
    "@happy-dom/global-registrator": "^20",
    "axe-core": "^4",
    "happy-dom": "^20",
    "postcss-html": "^1",
    "stylelint": "^16",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@9.0.6",
  "pnpm": {
    "patchedDependencies": {
      "@aiden0z/pptx-renderer@1.2.4": "patches/@aiden0z__pptx-renderer@1.2.4.patch"
    }
  }
}
